# VERSÃO COMPLETA COM SERVIDOR — OPENAI DIRETA
# Copie este arquivo para .env, na raiz, ao lado do package.json.
# No .env, insira a chave REAL depois do sinal =. Reinicie npm run dev.
# Na versão publicada, cadastre OPENAI_API_KEY nos segredos da hospedagem Sites.
# Nunca envie .env ao GitHub, nem coloque uma chave real neste exemplo/código.
# Nunca crie VITE_OPENAI_API_KEY. GitHub Pages não deve receber essa chave.
OPENAI_API_KEY=

# Opcionais: mantenha os padrões abaixo ou escolha modelos liberados na sua conta.
OPENAI_CHAT_MODEL=gpt-6-astra
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_VOICE=marin
